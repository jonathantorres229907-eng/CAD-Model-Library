    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 6 -6 0
      vertex 6 6 2
      vertex 6 -6 2
    endloop
  endfacet

  facet normal 0 0 1
    outer loop
      vertex 6 6 0
      vertex -6 6 0
      vertex -6 6 2
    endloop
